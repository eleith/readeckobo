server:
  port: 8080
log_level: info
readeck:
  host: "https://your-readeck-instance.com"
# Integration in progress: book sync and archived-article behavior are not wired up yet.
# Optional: public HTTPS origin used in Go-proxied Kobo initialization responses.
# public_url: "https://readeckobo.example.com"
users:
  - token: "a-very-secret-token-for-your-kobo"
    readeck_access_token: "your-plain-text-readeck-access-token"
    # Optional: overrides the Kobo Store fallback for this device.
    # book_sync_url: "https://books.example.com/api/kobo/device-token"
    # Optional: false preserves the current archived-article sync behavior.
    # remove_archived_from_kobo: false
